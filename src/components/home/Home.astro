---
import Button from "../ui/Button.astro";
import styles from "./Home.module.css";
import ChevronDown from "../icons/ChevronDown.astro";
import TranslationEnginerList from "./TranslationEnginerList.astro";
import Countries from "./Countries.astro";
import Skeleton from "./Skeleton.astro";
import Terminal from "./Terminal.astro";
import type { Message } from "./TerminalMessage.type";
import CodeEditor from "./CodeEditor.astro";
import AppsContainer from "./AppsContainer.astro";

const messages: Message[] = [
  {
    text: 'node dist/cli.cjs --text “Hello beautiful world” --from “en” --name "greeting"',
    duration: 2000,
    animation: "write",
  },
  {
    text: "Generating translations...",
    duration: 1000,
    animation: "fade",
    depth: 1,
  },
  {
    text: "Translated successfully to English with Google Translate: Hello beautiful world",
    duration: 700,
    animation: "fade",
    depth: 1,
    payload: {
      language: "en",
      translation: "Hello beautiful world",
      name: "greeting",
    },
  },
  {
    text: "Translated successfully to Spanish with Google Translate: Hola hermoso mundo",
    duration: 700,
    animation: "fade",
    depth: 1,
    payload: {
      language: "es",
      translation: "Hola hermoso mundo",
      name: "greeting",
    },
  },
  {
    text: "Translated successfully to Japanese with Google Translate: こんにちは美しい世界",
    duration: 700,
    animation: "fade",
    depth: 1,
    payload: {
      language: "jp",
      translation: "こんにちは美しい世界",
      name: "greeting",
    },
  },
  {
    text: "Translated successfully to French with Google Translate: Bonjour monde magnifique",
    duration: 700,
    animation: "fade",
    depth: 1,
    payload: {
      language: "fr",
      translation: "Bonjour monde magnifique",
      name: "greeting",
    },
  },
  {
    text: "Translated successfully to German with Google Translate: Hallo schöne Welt",
    duration: 700,
    animation: "fade",
    depth: 1,
    payload: {
      language: "de",
      translation: "Hallo schöne Welt",
      name: "greeting",
    },
  },
  {
    text: "",
    duration: 500,
    animation: "write",
    depth: 1,
  },
];
---

<main class={styles.Home}>
  <section class={styles["Home__hero"]}>
    <div class={styles["Home__hero-container"]}>
      <div class={styles["Home__hero-cta"]}>
        <h1 class={styles["Home__hero-title"]}>
          Crea traducciones en segundos con un solo comando
        </h1>
        <Button
          class={styles["Home__hero-button"]}
          href="https://github.com/heliomar-pena/i18n-populator?tab=readme-ov-file#get-started"
        >
          Empezar
        </Button>
      </div>
      <div class={styles["Home__hero-demo"]}>
        <AppsContainer>
          <Terminal
            slot="first-app"
            title="Terminal - Awesome Project"
            messages={messages}
          />
          <CodeEditor slot="second-app" />
        </AppsContainer>
      </div>
      <Button
        class={styles["Home__hero-button--small-screen"]}
        href="https://github.com/heliomar-pena/i18n-populator?tab=readme-ov-file#get-started"
      >
        Empezar
      </Button>
    </div>
    <footer class={styles["Home__hero-footer"]}>
      <a href="#how-it-works" class={styles["Home__hero-footer-anchor"]}>
        <div class={styles["Home__hero-footer-space"]}></div>
        <p class={styles["Home__hero-footer-text"]}>¿Cómo funciona?</p>
        <div class={styles["Home__hero-footer-icon"]}>
          <ChevronDown />
        </div>
      </a>
    </footer>
  </section>
  <div class={styles.Home__content}>
    <section
      class:list={[
        styles["Home__content-section"],
        styles["Home__translators"],
      ]}
    >
      <h2 id="how-it-works">
        Elige un motor de traducciones entre populares opciones
      </h2>
      <p>
        i18n-populator es una herramienta de consola que permite generar
        traducciones en segundos a diferentes idiomas haciendo uso de los
        motores de traducción que existen actualmente. Se integra con diferentes
        servicios que se encargan de generar la traducción del texto, pide
        traducir el texto proveído a cada uno de los idiomas deseados y luego
        inserta el resultado traducido en tus archivos de traducción de forma
        automática.
      </p>
      <p>
        Actualmente se da soporte a: <b
          >Bing, DeepL, Google, LibreTranslate and OpenAI API Compatible LLMs</b
        >
      </p>
      <TranslationEnginerList />
    </section>
    <section
      class:list={[styles["Home__content-section"], styles["Home__countries"]]}
    >
      <h2>Selecciona los países para los cuales deseas traducir</h2>
      <p>
        Crea un archivo de configuración para especificar todos los países a los
        que quieras agregar traducciones, puedes hacer esta configuración una
        vez, asi no deberás especificar todos los países manualmente cada vez.
      </p>
      <p>Actualmente se soportan idiomas de más de 150 países.</p>
      <Countries />
    </section>
    <sectison
      class:list={[styles["Home__content-section"], styles["Home__comparison"]]}
    >
      <h2>Empieza a generar traducciones con un solo comando</h2>
      <p>
        Cuando trabajas con proyectos internacionalizados, uno de trabajos más
        tediosos es agregar traducciones para cada texto incluído en cada uno de
        los idiomas soportados.
      </p>
      <p>
        Usando <b>i18n-populator</b> como herramienta central para agregar traducciones
        en tu equipo solo tienes que correr un comando para traducir el texto a todos
        los idiomas soportados, la mejor parte es que automaticamente agrega este
        texto a los archivos JSON de tu proyecto para ahorrarte el copiar y pegar.
      </p>
    </sectison>
    <div class={styles["Home__footer-cta"]}>
      <Button
        class={styles["Home__footer-cta-button"]}
        href="https://github.com/heliomar-pena/i18n-populator?tab=readme-ov-file#get-started"
      >
        Empezar a Generar Traducciones
      </Button>
    </div>
  </div>
</main>
